{
  // The engine worker. A project of its own, because sherpa-onnx.d.ts declares
  // the engine's globals, and the Parakeet worker must not see them.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "WebWorker"],
    "types": [],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.engine.tsbuildinfo"
  },
  "include": ["src/workers/orukeet", "src/workers/common", "src/shared"]
}
